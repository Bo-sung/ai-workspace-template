#!/bin/sh
# .agents/git-hooks/commit-msg
#
# Reject commits whose message contains generated co-author lines, model/tool
# signatures, or AI-generated promotional markers. Project commit policy
# (.agents/rules/commit_policy.md) overrides any tool default that auto-appends
# these strings.
#
# Activate per-repo:
#   git -C <repo> config core.hooksPath .agents/git-hooks
#
# $1 is the path to the commit message file (e.g. .git/COMMIT_EDITMSG).

set -u

msg_file=${1:-}
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg hook: missing or unreadable message file: ${msg_file}" >&2
    exit 1
fi

violations=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        *"Co-Authored-By:"*)
            violations="${violations}Co-Authored-By:
"
            ;;
    esac
    case "$line" in
        *"noreply@anthropic.com"*)
            violations="${violations}noreply@anthropic.com
"
            ;;
    esac
    case "$line" in
        *"Claude Opus"*)
            violations="${violations}Claude Opus
"
            ;;
    esac
    case "$line" in
        *"Generated by"*)
            violations="${violations}Generated by
"
            ;;
    esac
    case "$line" in
        *"Generated-by"*)
            violations="${violations}Generated-by
"
            ;;
    esac
    case "$line" in
        *"🤖"*)
            violations="${violations}🤖
"
            ;;
    esac
done < "$msg_file"

if [ -n "$violations" ]; then
    echo "" >&2
    echo "commit-msg hook: 거부됨 — commit 메시지에 금지 패턴이 포함되어 있습니다." >&2
    echo "commit-msg hook: rejected — forbidden patterns found in commit message:" >&2
    echo "" >&2
    printf '%s' "$violations" | while IFS= read -r violation || [ -n "$violation" ]; do
        [ -z "$violation" ] && continue
        printf '  - %s\n' "$violation" >&2
    done
    echo "" >&2
    echo "정책: .agents/rules/commit_policy.md (Forbidden Patterns 섹션)" >&2
    echo "Policy: .agents/rules/commit_policy.md ('Forbidden Patterns' section)" >&2
    echo "" >&2
    echo "조치: 메시지에서 위 줄을 제거하고 다시 commit 하세요. --no-verify 우회 금지." >&2
    echo "Action: remove the offending lines and re-commit. Do not use --no-verify." >&2
    echo "" >&2
    exit 1
fi

exit 0
